NODE_ENV=development
PORT=8787
HOST=127.0.0.1
BACKEND_BASE_URL=http://localhost:8787
CORS_ALLOWED_ORIGINS=https://www.figma.com,https://figma.com,null
ALLOWED_GOOGLE_WORKSPACE_DOMAIN=company.example
ENABLE_PUBLIC_SHEET_TEST_MODE=true
GOOGLE_OAUTH_CLIENT_ID=
