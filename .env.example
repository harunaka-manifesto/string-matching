# Plugin build only. Supply through your shell/CI environment; build does not auto-load this file.
COPY_REGISTRY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/copy-registry
COPY_TEAM_TOKEN=REPLACE_WITH_RANDOM_LIMITED_TEAM_TOKEN
# Edge Function secrets: comma-separated SHA-256 hashes (never the database credential).
COPY_TEAM_TOKEN_HASHES=REPLACE_WITH_TEAM_TOKEN_SHA256
COPY_PUBLISHER_TOKEN_HASHES=REPLACE_WITH_SEPARATE_PUBLISHER_TOKEN_SHA256
# Administrator tooling only. Never include these in the plugin build environment/artifact.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ADMIN_KEY=REPLACE_WITH_SERVER_ONLY_SECRET_KEY
COPY_BACKUP_KEY=REPLACE_WITH_BASE64_32_BYTE_BACKUP_ENCRYPTION_KEY
