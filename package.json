{
  "name": "string-binder",
  "private": true,
  "version": "3.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm build:order-index && pnpm --filter @string-binder/plugin build",
    "prepare:library": "node scripts/prepare-copy-library.mjs",
    "test:library": "node scripts/copy-migration/exact-merge.test.mjs",
    "build:order-index": "node scripts/build-order-index.mjs",
    "dev:ui": "pnpm --filter @string-binder/plugin dev:ui",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sandbox:check": "node scripts/check-plugin-sandbox.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
